# ========================================================
# CAREERGPT — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this to .env and fill in your values
# ========================================================

APP_ENV=development
SECRET_KEY=generate_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DATABASE
# For SQLite: sqlite:///./careergpt.db
# For PostgreSQL: postgresql://user:password@localhost:5432/careergpt
DATABASE_URL=

# AI PROVIDERS (openai, gemini, mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# STORAGE (local, s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# AWS / S3 Configuration (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# SYSTEM MODES
DEMO_MODE=true
LOG_LEVEL=INFO

# SECURITY
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
